<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The mssql plugin (docs/architecture.md §7.33). Built, packed and signed by NKeeper.Plugin.Build, which also builds
    ../frontend with npm. It brings the plugin's .nkp to ../artifacts/plugins.
  -->
  <PropertyGroup>
    <!--
      For Linux, where NKeeper runs: SqlClient's portable assembly only says the platform isn't supported, and its
      real one is per operating system. The package carries the Linux one.
    -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- English only: the package is flat, so each language's resources would land on one name. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The SDK and db-core's assembly are shared, from the server and from db-core, so they aren't copied (plugin-security.md §7.1). -->
    <PackageReference Include="NKeeper.Abstractions" ExcludeAssets="runtime" />
    <PackageReference Include="NKeeper.Plugins.Databases" ExcludeAssets="runtime" />
    <PackageReference Include="NKeeper.Plugin.Build" PrivateAssets="all" />
    <!-- The driver: the plugin's own, loaded in its own context. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NKeeper.Plugins.SqlServer.Tests" />
  </ItemGroup>

</Project>
